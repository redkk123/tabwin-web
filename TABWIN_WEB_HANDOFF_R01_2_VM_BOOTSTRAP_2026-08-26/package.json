{
  "name": "tabwin-web",
  "version": "0.8.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck:web": "tsc -p web.tsconfig.json",
    "web:dev": "vite --config vite.config.ts",
    "web:build": "vite build --config vite.config.ts",
    "web:preview": "vite preview --config vite.config.ts",
    "proxy:check": "wrangler deploy --dry-run --config apps/datasus-proxy/wrangler.jsonc --outdir dist/datasus-proxy",
    "proxy:dev": "wrangler dev --config apps/datasus-proxy/wrangler.jsonc",
    "proxy:deploy": "wrangler deploy --config apps/datasus-proxy/wrangler.jsonc",
    "proxy:rollback": "wrangler rollback --config apps/datasus-proxy/wrangler.jsonc",
    "verify:datasus-live": "npm run build && node scripts/verify-datasus-live.mjs",
    "materialize:g001": "npm run build && node scripts/materialize-g001.mjs",
    "verify:g001": "npm run build && node scripts/verify-g001-local.mjs",
    "verify:goldens": "npm run build && node scripts/verify-goldens-local.mjs",
    "verify:goldens:second": "npm run build && node scripts/verify-second-goldens-local.mjs",
    "verify:record-stream": "npm run build && node scripts/verify-record-stream.mjs",
    "inspect:cnv-n": "node scripts/inspect-new-format-cnv.mjs",
    "bench:record-stream": "npm run build && node --expose-gc --max-old-space-size=6144 scripts/measure-record-stream-memory.mjs",
    "bench:decode-breakdown": "npm run build && node scripts/measure-decode-breakdown.mjs",
    "bench:plan-projection": "npm run build && node --max-old-space-size=8192 scripts/measure-plan-projection.mjs",
    "check": "npm run test && npm run typecheck:web && npm run web:build"
  },
  "dependencies": {
    "@precisa-saude/datasus-dbc": "2.0.2",
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "8.2.2",
    "wrangler": "4.127.0"
  }
}
