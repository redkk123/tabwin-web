{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tabwin-web-datasus-proxy",
  "main": "./worker.mjs",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  // A revisão no ar precisa ser observável de fora. Sem isto, descobrir que
  // produção está velha exige medir comportamento — foi o que custou horas.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": {
    "enabled": true
  },
  "vars": {
    // As duas origens convivem de propósito durante a mudança de endereço.
    // Liberar a nova DEPOIS de o site mudar quebraria todo download no
    // instante da virada; liberar antes não custa nada, porque origem só é
    // aceita se o navegador realmente vier dela.
    "ALLOWED_ORIGINS": "https://redkk123.github.io,https://tabweb.me,https://www.tabweb.me",
    "MAX_FORM_BYTES": "65536",
    "MAX_FORM_RESPONSE_BYTES": "4194304",
    "MAX_ARCHIVE_BYTES": "536870912",
    "FORM_TIMEOUT_MS": "30000",
    "ARCHIVE_TIMEOUT_MS": "180000",
    "MAX_REDIRECTS": "3"
  }
}
