{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tabwin-web-datasus-proxy",
  "main": "./worker.mjs",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://redkk123.github.io",
    "MAX_FORM_BYTES": "65536",
    "MAX_FORM_RESPONSE_BYTES": "4194304",
    "MAX_ARCHIVE_BYTES": "536870912",
    "FORM_TIMEOUT_MS": "30000",
    "ARCHIVE_TIMEOUT_MS": "180000",
    "MAX_REDIRECTS": "3"
  }
}
